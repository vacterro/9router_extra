# 9router_WatchEdit repository hygiene
# NOTE: .gitignore is NOT a security boundary. Secrets must physically live
# outside the repository (see SECURITY_LOCAL.md). These rules only reduce
# accidents; the pre-commit hook and safe-share scanner provide the gates.

# --- Private / secret-bearing material (must NEVER exist in this repo) ---
backup/
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.db
jwt-secret
machine-id
.env
.env.*
*.vault
*.partial
credentials.json
providers-state-export.json
*.dpapi

# --- Local runtime state (belongs in %LOCALAPPDATA%\9router_WatchEdit) ---
health_cache.json
presets.json
settings.json
*.log
logs/

# --- Engine release artifacts (kept on disk, never committed) ---
packages/
patches/

# --- Python / tooling ---
__pycache__/
*.pyc
.pytest_cache/
dist/
build/
*.egg-info/

# --- Agent / editor state (IDENTITY.md is the portable lineage carrier and
#      must stay tracked; everything else under .saipen/ is local state) ---
.saipen/*
!.saipen/IDENTITY.md
# --- Translation kitchen locale READMEs are DELIBERATELY EXCLUDED from the
#      release surface and the gate. They are stale output from the translation
#      pipeline: all 29 kitchen README_*.md files carry digests that no longer
#      match README.md (source_digest b15c343ce499cb42), and the three root
#      locale files (README.ded.md, README.ee.md, README.ja.md) lack source-digest
#      stamps entirely. The translation service is not currently available to
#      regenerate them, so tracking stale surfaces would let a reader mistake
#      outdated prose for current docs. This omission is recorded here (T-114)
#      so the absence is intentional, not accidental. Re-enable tracking when
#      the kitchen can produce surfaces whose normalised digests match the live
#      README.md. ---
.saipen/saitranslate/kitchen/*/README_*.md
README.ded.md
README.ee.md
README.ja.md
.idea/
.vscode/

# --- Live provider/runtime caches (fetched data, never source) ---
.freebuff/

# --- Node tooling deps (the WatchEdit app is Python; node_modules only
#      holds the ad-hoc vitest cache used by the 9router build helper) ---
node_modules/
